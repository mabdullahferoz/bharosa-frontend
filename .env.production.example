# Copy to .env.production and fill in. Never commit the real file.

# Public address. A real domain gets HTTPS automatically (ports 80 and 443 must reach this server).
# Use SITE_ADDRESS=:80 to test locally over plain HTTP.
SITE_ADDRESS=app.example.pk

# Where Caddy proxies /api. The default reaches the API container from the bharosa-api repo.
API_UPSTREAM=api:4000

# Only if the app should call an API on another domain instead of its own /api:
# VITE_API_URL=https://api.example.pk/api
# API_ORIGIN=https://api.example.pk

HTTP_PORT=80
HTTPS_PORT=443
